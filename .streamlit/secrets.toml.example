# Copy to .streamlit/secrets.toml and fill in. secrets.toml is gitignored.
EMAILBISON_API_KEY = "your-api-token"
# Your EmailBison instance URL (the one you log in to). Optional.
EMAILBISON_BASE_URL = "https://dedi.emailbison.com"
# Claude API key for the Reply Intelligence page (console.anthropic.com -> API keys).
ANTHROPIC_API_KEY = "sk-ant-..."
# Optional: Claude model for classification. Defaults to the latest Sonnet.
# ANTHROPIC_MODEL = "claude-sonnet-5-5"
